# Loaded by Next.js only when NODE_ENV=development, i.e. under `next dev`.
#
# Next.js reads .env files from its own project root (frontend/), never from the
# repository root, so the root .env does not reach the frontend. Without this
# file, next.config.js and lib/api.ts both silently fall back to
# http://127.0.0.1:8000/api/v1 instead of using the configured value.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at compile time, so
# changing this file requires restarting the dev server to take effect.
#
# Safe to commit: host-facing URL, no secrets. Machine-local overrides belong in
# frontend/.env.development.local, which is gitignored.

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
